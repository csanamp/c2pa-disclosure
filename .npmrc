# Do not run dependency lifecycle scripts on install.
#
# @contentauth/c2pa-node's postinstall exists to replace the binary shipped in
# its npm tarball with one matching the host platform. The tarball already
# contains a Linux x86-64 build, so on a Linux x64 host — which is what CI and
# the Amplience processing-job runner use — that postinstall is a no-op that
# only creates ways to fail.
#
# And it does fail there. The runner's npm runs under Node 16, but the
# lifecycle script it spawns invokes a bare `node`, which resolves off PATH to a
# far older system Node that cannot parse the destructuring on line 10 of
# postinstall.cjs:
#
#   npm ERR! const { stat, readFile } = require('node:fs/promises');
#   npm ERR! SyntaxError: Unexpected token {
#   npm ERR!     at Module._compile (module.js:439:25)     <- Node 0.10-era internals
#
# Skipping scripts avoids that entirely and keeps the correct binary.
#
# Cost: on macOS or Windows the shipped Linux binary is wrong for the host.
# Run `npm run fix-binary` (or `npm run setup`) after installing. The CLI checks
# the binary loads before doing any work and says exactly that if it cannot.
ignore-scripts=true
